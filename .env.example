# Groq (free LLM inference) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Cerebras (free backup inference, used automatically if Groq is down/rate-limited)
# https://cloud.cerebras.ai — free, no card required
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Supabase (free Postgres + Auth) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Your production domain (no trailing slash) — used for SEO metadata,
# canonical URLs, the sitemap, robots.txt and the Open Graph/Twitter share
# image. Set this to your real Vercel/custom domain once deployed.
NEXT_PUBLIC_SITE_URL=https://pohana-ai.vercel.app
